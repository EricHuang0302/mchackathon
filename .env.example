# Run ./scripts/setup-local.sh to create a private .env with random keys.
# Values below illustrate the required names; do not use these placeholders.
POSTGRES_PASSWORD=replace-with-random-hex
LOCAL_INVITE_KEY=replace-with-fernet-key
API_PORT=8000
WEB_PORT=8080
PUBLIC_ORIGIN=http://127.0.0.1:8080
GEMINI_MODEL=
GOOGLE_API_KEY=
# Set to 1 only for synthetic demonstrations of the unreviewed rule bundle.
ENABLE_UNREVIEWED_DEMO_RULES=0
