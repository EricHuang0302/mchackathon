          "params": {}
        },
        "timerOps": [
          {
            "op": "stop",
            "timerId": "cpr_reminder",
            "intervalMs": 120000,
            "repeat": true,
            "audible": true,
            "reason": "state_entry"
          },
          {
            "op": "stop",
            "timerId": "reassess_breathing",
            "intervalMs": 60000,
            "repeat": false,
            "audible": true,
            "reason": "state_entry"
          }
        ]
