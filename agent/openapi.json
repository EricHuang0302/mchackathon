  "components": {
    "schemas": {
      "AedCandidate": {
        "additionalProperties": false,
        "properties": {
          "aedId": {
            "title": "Aedid",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "availability": {
            "enum": [
              "available",
              "unavailable",
              "unknown"
            ],
            "title": "Availability",
            "type": "string"
          },
          "straightLineMeters": {
            "minimum": 0,
            "title": "Straightlinemeters",
            "type": "number"
          },
          "walkingMeters": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Walkingmeters"
          },
          "etaSeconds": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Etaseconds"
          },
          "routeUpdatedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Routeupdatedat"
          },
          "estimateSource": {
            "enum": [
              "route",
              "straight_line",
              "none"
            ],
            "title": "Estimatesource",
            "type": "string"
          }
        },
        "required": [
          "aedId",
          "name",
          "availability",
          "straightLineMeters",
          "estimateSource"
        ],
        "title": "AedCandidate",
        "type": "object"
      },
      "AedListResponse": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/AedCandidate"
            },
            "title": "Candidates",
            "type": "array"
          },
          "dataUpdatedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataupdatedat"
          }
        },
        "required": [
          "candidates",
          "dataUpdatedAt"
        ],
        "title": "AedListResponse",
        "type": "object"
      },
      "CreateIncidentRequest": {
        "additionalProperties": false,
        "properties": {
          "incidentId": {
            "format": "uuid",
            "title": "Incidentid",
            "type": "string"
          },
          "primaryClientId": {
            "format": "uuid",
            "title": "Primaryclientid",
            "type": "string"
          },
          "ruleVersion": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Ruleversion",
            "type": "string"
          }
        },
        "required": [
          "incidentId",
          "primaryClientId",
          "ruleVersion"
        ],
        "title": "CreateIncidentRequest",
        "type": "object"
      },
      "CreateShareRequest": {
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "helperId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Helperid"
          },
          "expiresInSeconds": {
            "maximum": 3600,
            "minimum": 60,
            "title": "Expiresinseconds",
            "type": "integer"
          },
          "idempotencyKey": {
            "format": "uuid",
            "title": "Idempotencykey",
            "type": "string"
          }
        },
        "required": [
          "scope",
          "expiresInSeconds",
          "idempotencyKey"
        ],
        "title": "CreateShareRequest",
        "type": "object"
      },
      "CreateShareResponse": {
        "additionalProperties": false,
        "properties": {
          "inviteId": {
            "format": "uuid",
            "title": "Inviteid",
            "type": "string"
          },
          "secret": {
            "title": "Secret",
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          }
        },
        "required": [
          "inviteId",
          "secret",
          "scope",
          "expiresAt"
        ],
        "title": "CreateShareResponse",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "unauthorized",
              "expired",
              "stale_revision",
              "rule_mismatch",
              "unavailable",
              "invalid_input"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Details"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventAck": {
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "format": "uuid",
            "title": "Eventid",
            "type": "string"
          },
          "status": {
            "enum": [
              "accepted",
              "duplicate",
              "conflict"
            ],
            "title": "Status",
            "type": "string"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Code"
          }
        },
        "required": [
          "eventId",
          "status"
        ],
        "title": "EventAck",
        "type": "object"
      },
      "EventBatchRequest": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventInput"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "EventBatchRequest",
        "type": "object"
      },
      "EventBatchResponse": {
        "additionalProperties": false,
        "properties": {
          "acknowledgements": {
            "items": {
              "$ref": "#/components/schemas/EventAck"
            },
            "title": "Acknowledgements",
            "type": "array"
          },
          "stateRevision": {
            "title": "Staterevision",
            "type": "integer"
          },
          "modeRevision": {
            "title": "Moderevision",
            "type": "integer"
          },
          "snapshotRevision": {
            "title": "Snapshotrevision",
            "type": "integer"
          },
          "authorityEpoch": {
            "title": "Authorityepoch",
            "type": "integer"
          },
          "lastAcknowledgedClientSequence": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Lastacknowledgedclientsequence"
          }
        },
        "required": [
          "acknowledgements",
          "stateRevision",
          "modeRevision",
          "snapshotRevision",
          "authorityEpoch"
        ],
        "title": "EventBatchResponse",
        "type": "object"
      },
      "EventInput": {
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "format": "uuid",
            "title": "Eventid",
            "type": "string"
          },
          "type": {
            "enum": [
              "mode.changed",
              "call.reported",
              "action.reported",
              "event.corrected",
              "observation.proposed",
              "observation.confirmed",
              "command.acknowledged",
              "timer.elapsed",
              "helper.updated"
            ],
            "title": "Type",
            "type": "string"
          },
          "detail": {
            "additionalProperties": true,
            "title": "Detail",
            "type": "object"
          },
          "clientId": {
            "format": "uuid",
            "title": "Clientid",
            "type": "string"
          },
          "clientInstanceId": {
            "format": "uuid",
            "title": "Clientinstanceid",
            "type": "string"
          },
          "clientSequence": {
            "minimum": 0,
            "title": "Clientsequence",
            "type": "integer"
          },
          "clientTime": {
            "format": "date-time",
            "title": "Clienttime",
            "type": "string"
          },
          "authorityEpoch": {
            "minimum": 1,
            "title": "Authorityepoch",
            "type": "integer"
          },
          "stateRevision": {
            "minimum": 0,
            "title": "Staterevision",
            "type": "integer"
          },
          "modeRevision": {
            "minimum": 0,
            "title": "Moderevision",
            "type": "integer"
          },
          "ruleVersion": {
            "minLength": 1,
            "title": "Ruleversion",
            "type": "string"
          }
        },
        "required": [
          "eventId",
          "type",
          "detail",
          "clientId",
          "clientInstanceId",
          "clientSequence",
          "clientTime",
          "authorityEpoch",
          "stateRevision",
          "modeRevision",
          "ruleVersion"
        ],
        "title": "EventInput",
        "type": "object"
      },
      "HandoffEvent": {
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "format": "uuid",
            "title": "Eventid",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          },
          "clientTime": {
            "format": "date-time",
            "title": "Clienttime",
            "type": "string"
          },
          "serverTime": {
            "format": "date-time",
            "title": "Servertime",
            "type": "string"
          },
          "detail": {
